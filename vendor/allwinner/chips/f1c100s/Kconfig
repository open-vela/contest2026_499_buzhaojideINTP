if ARCH_CHIP_CUSTOM

comment "Allwinner F1C100s Configuration Options"

choice
	prompt "Allwinner F1C100s Chip Selection"
	default ARCH_CHIP_F1C100S

config ARCH_CHIP_F1C100S
	bool "F1C100s"
	select ARCH_ARM926EJS
	select ARCH_HAVE_MMU
	select ARCH_USE_MMU
	select ARCH_HAVE_LOWVECTORS
	select ARCH_LOWVECTORS
	select ARCH_HAVE_RESET
	---help---
		Allwinner F1C100s ARM926EJ-S SoC with 32MB integrated DDR

endchoice

menu "F1C100s Peripheral Selection"

config F1C100S_UART0
	bool "UART0"
	default y
	select UART0_SERIALDRIVER
	---help---
		Enable UART0 serial port

config F1C100S_UART1
	bool "UARTConfiguration 1"
	default n
	select UART1_SERIALDRIVER
	---help---
		Enable UART1 serial port

config F1C100S_UART2
	bool "UART2"
	default n
	select UART2_SERIALDRIVER
	---help---
		Enable UART2 serial port

config F1C100S_SPI0
	bool "SPI0"
	default n
	select SPI
	---help---
		Enable SPI0 controller

config F1C100S_SPI1
	bool "SPI1"
	default n
	select SPI
	---help---
		Enable SPI1 controller

config F1C100S_I2C0
	bool "I2C0 (TWI0)"
	default n
	select I2C
	---help---
		Enable I2C0/TWI0 controller

config F1C100S_I2C1
	bool "I2C1 (TWI1)"
	default n
	select I2C
	---help---
		Enable I2C1/TWI1 controller

config F1C100S_I2C2
	bool "I2C2 (TWI2)"
	default n
	select I2C
	---help---
		Enable I2C2/TWI2 controller

config F1C100S_SDIO
	bool "SDIO/SD/MMC"
	default n
	select MMCSD
	select MMCSD_SDIO
	select SDIO_BLOCKSETUP
	select ARCH_HAVE_SDIO
	---help---
		Enable SDIO/SD/MMC controller (SDC0)

config F1C100S_AUDIO
	bool "Audio Codec"
	default n
	select AUDIO
	select F1C100S_DMA
	---help---
		Enable internal Audio Codec

config F1C100S_DMA
	bool "DMA Support"
	default n
	---help---
		Enable DMA controller support (NDMA/DDMA)

config F1C100S_WDT
	bool "Watchdog Timer"
	default n
	select WATCHDOG
	---help---
		Enable Watchdog Timer support.
		WATCHDOG_AUTOMONITOR is intentionally not auto-selected:
		this board's JTAG cable has no SRST/nRST line, so a debug
		halt is indistinguishable from a hang to the watchdog.
		An automonitor timeout during a JTAG halt resets the whole
		board, dropping back to whatever firmware the boot media
		actually holds. Enable WATCHDOG_AUTOMONITOR explicitly only
		once JTAG is no longer needed for development.

if F1C100S_WDT

config F1C100S_WDT_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	default 5000
	range 500 16000
	---help---
		Hardware WDT interval. The feed period must be shorter.

config F1C100S_WDT_FEED_MS
	int "Watchdog feed period (ms)"
	default 2000
	range 100 8000
	---help---
		Periodic keepalive. Must be less than F1C100S_WDT_TIMEOUT_MS.

endif # F1C100S_WDT

config F1C100S_BL_WAIT_SEC
	int "BL fastboot wait timeout (seconds)"
	default 60
	range 5 600
	---help---
		How long BL waits for a host fastboot connection before
		trying the current AP anyway (spec §2 / §5).

config F1C100S_FB
	bool "Framebuffer (LCD/TV)"
	default n
	select FB
	---help---
		Enable framebuffer driver for LCD/TV output.
		Supports TFT LCD (via TCON0) and TV (PAL/NTSC via TCON1+TVE).

config F1C100S_PWM
	bool "PWM Controller"
	default n
	select PWM
	---help---
		Enable PWM controller support.
		F1C100s has 2 PWM channels (PWM0 on PE12, PWM1 on PE6).

config F1C100S_ONESHOT
	bool "Oneshot Timer"
	default n
	select ONESHOT
	---help---
		Enable Oneshot Timer driver using Timer1.
		Provides user-space timer via /dev/timer0.

if F1C100S_PWM

config F1C100S_PWM0
	bool "PWM Channel 0"
	default y
	---help---
		Enable PWM channel 0. Pin is selected below.

if F1C100S_PWM0

choice
	prompt "PWM0 Pin Selection"
	default F1C100S_PWM0_PA2 if F1C100S_I2C0_PE
	default F1C100S_PWM0_PE12
	---help---
		F1C100S UM section 4.2.3: PWM0 is available as an alternate
		function on two pins. PE12 also carries I2C0's SDA when
		F1C100S_I2C0_PE is selected (see that choice's help text) -
		pick PA2 on boards that need both PWM0 and I2C0 on Port E.

config F1C100S_PWM0_PA2
	bool "PA2 (Function 3)"
	---help---
		Avoids the PE12 conflict with F1C100S_I2C0_PE.

config F1C100S_PWM0_PE12
	bool "PE12 (Function 4)"
	---help---
		Conflicts with F1C100S_I2C0_PE (I2C0 SDA also on PE12).
		Only select this if I2C0 is off, or routed to PD0/PD12
		instead (F1C100S_I2C0_PD).

endchoice

endif # F1C100S_PWM0

config F1C100S_PWM1
	bool "PWM Channel 1 (PE6)"
	default n
	---help---
		Enable PWM channel 1 on PE6.

endif # F1C100S_PWM

menu "USB Support"

config F1C100S_USB
	bool "Enable USB Controller"
	default n
	---help---
		Enable the F1C100s USB OTG controller.

if F1C100S_USB

choice
	prompt "USB Mode"
	default F1C100S_USBDEV

config F1C100S_USBDEV
	bool "USB Device Mode"
	select USBDEV
	---help---
		Enable USB Device mode. The F1C100s will act as a USB peripheral.

config F1C100S_USBHOST
	bool "USB Host Mode"
	select USBHOST
	select USBHOST_HAVE_ASYNCH
	---help---
		Enable USB Host mode. The F1C100s will act as a USB host controller.

endchoice

if F1C100S_USBDEV

config F1C100S_USBDEV_HIGHSPEED
	bool "High Speed (480 Mbps)"
	default y
	select USBDEV_DUALSPEED
	---help---
		y: High Speed 480 Mbps. Bulk wMaxPacket=512, PHY HSENAB.
		   Use this for RNDIS (network), ADB, or Fastboot — each
		   alone fits in the 2KB FIFO (RNDIS ~1104 bytes).
		n: Full Speed 12 Mbps, bulk wMaxPacket=64.

		Do not set HSENAB without this option: Linux then sees
		64-byte bulk at 480 Mbps (invalid maxpacket).

choice F1C100S_USBDEV_FUNCTION
	prompt "USB device function"
	default F1C100S_USB_ADB
	optional
	---help---
		Only EP1-EP3 take bulk/interrupt on this silicon (EP4/EP5
		bulk is EPROTO/EPIPE). Pick one function. High Speed is
		valid for every option below.

config F1C100S_USB_ADB
	bool "ADB (EP1 IN + EP2 OUT)"
	select USBADB
	---help---
		2 endpoints. High Speed OK.

config F1C100S_USB_RNDIS
	bool "RNDIS network (EP1 INT + EP2 IN + EP3 OUT)"
	select RNDIS
	---help---
		3 endpoints. High Speed OK — this is the network gadget.

config F1C100S_USB_NET
	bool "Dynamic Network (RNDIS / CDC-ECM via /data/net_mode)"
	select RNDIS
	select NET_CDCECM
	---help---
		3 endpoints. Dynamically switches between RNDIS (Windows/Linux)
		and CDC-ECM (macOS/Linux) based on /data/net_mode.

config F1C100S_USB_FASTBOOT
	bool "Fastboot (EP1 IN + EP2 OUT)"
	select USBADB
	select USBFASTBOOT
	---help---
		2 endpoints. High Speed OK. BL uses this.

config F1C100S_USB_CDCACM
	bool "CDC ACM (EP1 INT + EP2 IN + EP3 OUT)"
	select CDCACM
	---help---
		3 endpoints. High Speed OK.

config F1C100S_USB_MSC
	bool "Mass Storage (EP1 IN + EP2 OUT)"
	select USBMSC
	---help---
		2 endpoints. High Speed OK.

endchoice

config F1C100S_USB_COMPOSITE
	bool
	default n
	select USBDEV_COMPOSITE
	select CDCACM_COMPOSITE if F1C100S_USB_CDCACM
	select USBADB_COMPOSITE if F1C100S_USB_ADB
	select RNDIS_COMPOSITE if F1C100S_USB_RNDIS
	---help---
		Left off: EP1-EP3 only hold one function, so gadgets
		run standalone (cdcacm_initialize / usbdev_adb_initialize /
		usbdev_rndis_initialize).

endif # F1C100S_USBDEV

if F1C100S_USBHOST

config F1C100S_USBHOST_HUB
	bool "USB Hub Support"
	default y
	select USBHOST_HUB
	---help---
		Enable USB Hub support to connect multiple devices.

config F1C100S_USBHOST_PRIO
	int "USB Host Waiter Thread Priority"
	default 100
	---help---
		Priority of the USB host waiter thread.

config F1C100S_USBHOST_STACKSIZE
	int "USB Host Waiter Thread Stack Size"
	default 2048
	---help---
		Stack size for the USB host waiter thread.

config F1C100S_USBHOST_VBUS_DETECT
	bool "VBUS Detection via GPIO"
	default n
	depends on DEV_GPIO && SCHED_HPWORK
	---help---
		Enable VBUS detection using an external GPIO pin.
		When enabled, device connection is detected via GPIO interrupt
		instead of relying solely on the USB controller's internal detection.

if F1C100S_USBHOST_VBUS_DETECT

config F1C100S_USBHOST_VBUS_DEVPATH
	string "VBUS Detection GPIO Device Path"
	default "/dev/gpio_usb_det"
	---help---
		Path to the GPIO device used for VBUS detection.
		This GPIO should be connected to the USB VBUS detect signal.

config F1C100S_USBHOST_VBUS_INVERTED
	bool "VBUS Detection Signal Inverted"
	default n
	---help---
		Set this if the VBUS detection signal is active low.
		Normal: High = device connected, Low = disconnected
		Inverted: Low = device connected, High = disconnected

endif # F1C100S_USBHOST_VBUS_DETECT

endif # F1C100S_USBHOST

endif # F1C100S_USB

endmenu

endmenu

menu "F1C100s SPI Configuration"
	depends on F1C100S_SPI0 || F1C100S_SPI1

config F1C100S_SPI_DMA
	bool "SPI DMA Support"
	default y
	depends on F1C100S_DMA
	---help---
		Enable DMA support for SPI transfers.
		Transfers larger than 16 bytes will automatically use DMA.

config F1C100S_SPI_DMA_SG
	bool "SPI Scatter-Gather DMA"
	default n
	depends on F1C100S_SPI_DMA
	select F1C100S_DMA_SG
	---help---
		Enable scatter-gather for SPI transfers.
		Useful for protocol headers + data transfers.

config F1C100S_SPI_DMA_THRESHOLD
	int "SPI DMA Threshold (bytes)"
	default 16
	depends on F1C100S_SPI_DMA
	---help---
		Minimum transfer size to trigger DMA usage.
		Smaller transfers will use PIO mode.

endmenu

menu "F1C100S I2C Configuration"
	depends on F1C100S_I2C0 || F1C100S_I2C1 || F1C100S_I2C2

if F1C100S_I2C0

choice
	prompt "I2C0 Pin Selection"
	default F1C100S_I2C0_PE
	---help---
		Select which pin group to use for I2C0 (TWI0).

config F1C100S_I2C0_PE
	bool "Port E: PE11/PE12 (SCK: PE11, SDA: PE12)"
	---help---
		Use PE11 (TWI0_SCK, Func 3) and PE12 (TWI0_SDA, Func 3).
		Default choice. Avoids pin conflict with LCD RGB signals (PD0-PD21)
		when framebuffer (CONFIG_F1C100S_FB) is enabled.
		NOTE: PE12 is also used by PWM0 (Func 4). If CONFIG_F1C100S_PWM0 is
		enabled, a pinmux conflict will occur on PE12.

config F1C100S_I2C0_PD
	bool "Port D: PD12/PD0 (SCK: PD12, SDA: PD0)"
	---help---
		Use PD12 (TWI0_SCK, Func 3) and PD0 (TWI0_SDA, Func 3).
		WARNING: Conflicts with LCD RGB signals (PD0-PD21) when
		CONFIG_F1C100S_FB is enabled.

endchoice

endif # F1C100S_I2C0

config F1C100S_I2C_INTERRUPTS
	bool "I2C Interrupt Mode"
	default y
	---help---
		Enable interrupt-driven I2C transfers with state machine.
		Significantly reduces CPU usage compared to polling mode.

config F1C100S_I2C_TIMEOUT_MS
	int "I2C Transfer Timeout (ms)"
	default 20
	---help---
		Timeout for I2C transfers in milliseconds.
		Lower values speed up I2C bus scanning but may cause issues with slow devices.

endmenu

menu "F1C100s SDIO Configuration"
	depends on F1C100S_SDIO

config F1C100S_SDIO_DMA
	bool "SDIO DMA Support"
	default y
	select SDIO_DMA
	---help---
		Enable IDMAC (Internal DMA) for SDIO transfers.
		Greatly improves SD card read/write performance.

config F1C100S_SDIO_WIDTH_D1_ONLY
	bool "SDIO 1-bit Mode Only"
	default n
	---help---
		Restrict SDIO to 1-bit data width.
		Enable this if 4-bit mode causes issues.

config F1C100S_SDIO_DMADEBUG
	bool "SDIO DMA Debug"
	default n
	depends on F1C100S_SDIO_DMA && DEBUG_FEATURES
	---help---
		Enable debug output for SDIO DMA operations

config F1C100S_SDIO_CARDDETECT
	bool "SD Card Detection (Hot-plug)"
	default n
	depends on DEV_GPIO
	select MMCSD_HAVE_CARDDETECT
	---help---
		Enable SD card hot-plug detection using GPIO.
		When enabled, the system can detect card insertion and removal
		at runtime without rebooting.

config F1C100S_SDIO_CD_DEVPATH
	string "Card Detect GPIO Device Path"
	default "/dev/gpio0"
	depends on F1C100S_SDIO_CARDDETECT
	---help---
		The device path of the GPIO pin used for card detection.
		Example: /dev/gpio0, /dev/gpioCD, etc.

config F1C100S_SDIO_CD_INVERTED
	bool "Card Detect Signal Inverted"
	default n
	depends on F1C100S_SDIO_CARDDETECT
	---help---
		Set this if the card detect signal is inverted.
		Normal: Low = card inserted, High = card removed
		Inverted: High = card inserted, Low = card removed

endmenu

