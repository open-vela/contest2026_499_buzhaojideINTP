	bool "Audio DMA Support"
	default y
	depends on F1C100S_DMA
	---help---
		Enable DMA for audio playback and recording.
		Provides continuous audio with automatic buffer chaining.

config F1C100S_AUDIO_DMA_CHAIN
	bool "Audio DMA Chain Mode"
	default n
	depends on F1C100S_AUDIO_DMA
	select F1C100S_DMA_CHAIN
	---help---
		Use descriptor chain for continuous audio playback.
		Reduces CPU overhead for buffer switching.

config F1C100S_AUDIO_NUM_BUFFERS
	int "Number of Audio Buffers"
	default 4
	range 2 8
	---help---
		Number of audio buffers for DMA operation

config F1C100S_AUDIO_BUFFER_SIZE
	int "Audio Buffer Size (bytes)"
	default 4096
	range 1024 16384
	---help---
		Size of each audio buffer

endmenu

menu "F1C100s DMA Configuration"
	depends on F1C100S_DMA

config F1C100S_DMA_CHAIN
	bool "DMA Descriptor Chain Support"
	default n
	---help---
		Enable software descriptor chain for linked DMA transfers.
		Allows multiple transfers to execute sequentially without
		CPU intervention between transfers.

config F1C100S_DMA_SG
	bool "DMA Scatter-Gather Support"
	default n
	depends on F1C100S_DMA_CHAIN
	---help---
		Enable scatter-gather DMA transfers.
		Allows transferring data between multiple non-contiguous
		memory regions in a single operation.
		Requires descriptor chain support.

config F1C100S_DMA_NDMA_CHANNELS
	int "Number of NDMA Channels"
	default 4
	range 1 4
	---help---
		Number of Normal DMA channels to support (1-4)

config F1C100S_DMA_DDMA_CHANNELS
	int "Number of DDMA Channels"
	default 4
	range 1 4
	---help---
		Number of Dedicated DMA channels to support (1-4)

config F1C100S_DMA_DEBUG
	bool "DMA Debug Output"
	default n
	depends on DEBUG_FEATURES
	---help---
		Enable debug output for DMA operations

endmenu

menu "F1C100s Framebuffer Configuration"
	depends on F1C100S_FB

choice
	prompt "LCD Resolution"
	default F1C100S_FB_480x272

config F1C100S_FB_320x240
	bool "320x240 (QVGA, 2.4-3.5 inch)"

config F1C100S_FB_480x272
	bool "480x272 (4.3 inch)"

config F1C100S_FB_640x480
	bool "640x480 (VGA)"

config F1C100S_FB_800x480
	bool "800x480 (5-7 inch)"

config F1C100S_FB_1024x600
	bool "1024x600 (10.1 inch)"

config F1C100S_FB_CUSTOM
	bool "Custom resolution"

endchoice

config F1C100S_FB_WIDTH
	int "LCD Width (pixels)"
	default 320 if F1C100S_FB_320x240
	default 480 if F1C100S_FB_480x272
	default 640 if F1C100S_FB_640x480
	default 800 if F1C100S_FB_800x480
	default 1024 if F1C100S_FB_1024x600
	default 480

config F1C100S_FB_HEIGHT
	int "LCD Height (pixels)"
	default 240 if F1C100S_FB_320x240
	default 272 if F1C100S_FB_480x272
	default 480 if F1C100S_FB_640x480
	default 480 if F1C100S_FB_800x480
	default 600 if F1C100S_FB_1024x600
	default 272

config F1C100S_FB_HFP
	int "Horizontal front porch (pixels)"
	default 2 if F1C100S_FB_480x272
	default 40 if F1C100S_FB_800x480
	default 8
	---help---
		Horizontal front porch (HFP) in pixels/dclk.

config F1C100S_FB_HBP
	int "Horizontal back porch (pixels)"
	default 2 if F1C100S_FB_480x272
	default 87 if F1C100S_FB_800x480
	default 16
	---help---
		Horizontal back porch (HBP) in pixels/dclk.

config F1C100S_FB_HSW
	int "Horizontal sync width (pixels)"
	default 41 if F1C100S_FB_480x272
	default 1 if F1C100S_FB_800x480
	default 1
	---help---
		Horizontal sync width (HSW) in pixels/dclk.

config F1C100S_FB_VFP
	int "Vertical front porch (lines)"
	default 2 if F1C100S_FB_480x272
	default 13 if F1C100S_FB_800x480
	default 4
	---help---
		Vertical front porch (VFP) in lines.

config F1C100S_FB_VBP
	int "Vertical back porch (lines)"
	default 2 if F1C100S_FB_480x272
	default 31 if F1C100S_FB_800x480
	default 8
	---help---
		Vertical back porch (VBP) in lines.

config F1C100S_FB_VSW
	int "Vertical sync width (lines)"
	default 10 if F1C100S_FB_480x272
	default 3 if F1C100S_FB_800x480
	default 1
	---help---
		Vertical sync width (VSW) in lines.

config F1C100S_FB_PLL
	hex "PLL_VIDEO_CTRL register value"
	default 0x80000800 if F1C100S_FB_480x272
	default 0x81004107 if F1C100S_FB_800x480
	default 0x80000800
	---help---
		PLL_VIDEO control register (0x01c20010).
		Integer mode: bit31 enable, N in [14:8] (encoded N-1),
		M in [3:0] (encoded M-1). Bit24 is FRAC enable (270/297 MHz)
		and must stay clear for the 216 MHz 480x272 clock.
		Default for 480x272: 0x80000800 (24 MHz * 9 / 1 = 216 MHz).
		Default for 800x480: 0x81004107 (~198 MHz).

config F1C100S_FB_CLKDIV
	int "Dot clock divider (DCLK = PLL / CLKDIV)"
	default 24 if F1C100S_FB_480x272
	default 6 if F1C100S_FB_800x480
	default 24
	---help---
		TCON0 DCLK divider (TCON_CLK_CTRL_REG bits 7:0).
		For 480x272: 216MHz / 24 = 9.0 MHz exact dot clock.
		For 800x480: 198MHz / 6 = 33 MHz.

config F1C100S_FB_INV
	int "IO polarity invert mask"
	default 0
	---help---
		Invert signals (DCLK, DE, HSYNC, VSYNC). Default 0 (active high DE).

config F1C100S_FB_BACKLIGHT_PWM
	bool "Auto-enable RGB Backlight via PWM"
	default y
	depends on F1C100S_PWM
	---help---
		Automatically initialize and start PWM backlight on board bringup
		when Framebuffer is enabled. For this board, PWM1 (PE6) drives
		the AP3019AKTR step-up backlight circuit for the 40-pin RGB FPC.

config F1C100S_FB_BACKLIGHT_DUTY
	int "Backlight default duty cycle (percent)"
	default 80
	range 0 100
	depends on F1C100S_FB_BACKLIGHT_PWM
	---help---
		Initial backlight brightness duty cycle percentage (0-100%).

config F1C100S_FB_BPP
	int "Bits per pixel"
	default 16
	range 16 32
	---help---
		Color depth: 16 (RGB565), 24 (RGB888), or 32 (ARGB8888)

choice
	prompt "Display Output"
	default F1C100S_FB_TFT

config F1C100S_FB_TFT
	bool "TFT LCD (RGB)"
	---help---
		Output to TFT LCD panel via TCON0

config F1C100S_FB_TV_PAL
	bool "TV (PAL)"
	---help---
		Output to TV via TCON1+TVE in PAL format

config F1C100S_FB_TV_NTSC
	bool "TV (NTSC)"
	---help---
		Output to TV via TCON1+TVE in NTSC format

endchoice

config F1C100S_FB_RB_SWAP
	bool "Swap Red and Blue channels (RB Swap)"
	default y
	depends on F1C100S_FB_TFT
	---help---
		Swap Red and Blue channels in TCON0 (bit 23 of TCON_T0_CTRL).
		Enable when RGB LCD panel wiring causes Red and Blue to be reversed.

config F1C100S_FB_DMA
	bool "Framebuffer DMA Support"
	default n
	depends on F1C100S_DMA
	---help---
		Enable DMA for framebuffer updates.
		Improves display refresh performance.

config F1C100S_FB_DMA_CHAIN
	bool "Framebuffer DMA Chain Mode"
	default n
	depends on F1C100S_FB_DMA
	select F1C100S_DMA_CHAIN
	---help---
		Use descriptor chain for double-buffered display.
		Enables smooth frame transitions.

endmenu

menu "F1C100s USB Configuration"
	depends on F1C100S_USB

config F1C100S_USB_DMA
	bool "USB DMA Support"
	default n
	depends on F1C100S_DMA && (F1C100S_USBHOST || F1C100S_USBDEV)
	---help---
		Enable DMA for USB bulk transfers. When enabled,
		transfers >= threshold bytes use DMA, smaller use PIO.

config F1C100S_USB_DMA_THRESHOLD
	int "USB DMA Threshold (bytes)"
	default 64
	depends on F1C100S_USB_DMA
	---help---
		Minimum transfer size to use DMA. Smaller transfers use PIO.

config F1C100S_USB_DMA_CHAIN
	bool "USB DMA Chain Mode"
	default n
	depends on F1C100S_USB_DMA
	select F1C100S_DMA_CHAIN
	---help---
		Use descriptor chain for USB bulk transfers.
		Reduces CPU overhead for large transfers.

config F1C100S_USB_DMA_SG
	bool "USB Scatter-Gather DMA"
	default n
	depends on F1C100S_USB_DMA_CHAIN
	select F1C100S_DMA_SG
	---help---
		Enable scatter-gather for USB transfers.
		Useful for fragmented buffer transfers.

endmenu

menu "F1C100s UART DMA Configuration"
	depends on F1C100S_UART0 || F1C100S_UART1 || F1C100S_UART2

config F1C100S_UART_DMA
	bool "UART DMA Support"
	default n
	depends on F1C100S_DMA
	---help---
		Enable DMA for UART transfers.
		Useful for high-speed serial communication.

config F1C100S_UART_DMA_CHAIN
	bool "UART DMA Chain Mode"
	default n
	depends on F1C100S_UART_DMA
	select F1C100S_DMA_CHAIN
	---help---
		Use descriptor chain for UART DMA transfers.
		Enables large buffer transfers without CPU intervention.

endmenu

config F1C100S_GPIO
	bool
	default y
	---help---
		GPIO support is always enabled on F1C100s

config F1C100S_LRADC
	bool "LRADC (ADC Buttons)"
	default n
	select INPUT
	select INPUT_BUTTONS
	---help---
		Enable LRADC (Low Resolution ADC) driver for button input.
		Uses ADC to detect multiple buttons through resistor divider network.
		Do NOT enable on the F1C200S 小电脑 demo board: SW1/SW2/SW3 are
		independent GPIOs (PE2/PE3/PE4), not an LRADC divider. Use
		F1C100S_GPIO_BUTTONS instead.

config F1C100S_GPIO_BUTTONS
	bool "GPIO keys (PE2/PE3/PE4, active-low)"
	default n
	select ARCH_HAVE_BUTTONS
	select ARCH_BUTTONS
	select ARCH_HAVE_IRQBUTTONS
	select ARCH_IRQBUTTONS
	select INPUT
	select INPUT_BUTTONS
	select INPUT_BUTTONS_LOWER
	select DEV_GPIO
	---help---
		On-board SW1/SW2/SW3 from SCH_F1C200S小电脑.pdf: each key is a
		GPIO to GND with a 47k pull-up to 3.3V (active-low).
		  SW1 L  = PE2
		  SW2 CK = PE3
		  SW3 R  = PE4
		PE4 is only the key; ST7789 DC/RST are PE5/PE10.

menu "F1C100s Boot Configuration"

config F1C100S_DRAM_INIT
	bool "Initialize DRAM in NuttX"
	default n
	---help---
		Enable DRAM initialization in NuttX startup code.
		Disable this if bootloader (awboot/FEL) already initialized DRAM.

choice
	prompt "JTAG Configuration"
	default F1C100S_JTAG_DISABLE

config F1C100S_JTAG_DISABLE
	bool "Disable JTAG"
	---help---
		JTAG pins (PF0-PF5) are available for GPIO/SD Card use.

config F1C100S_JTAG_ENABLE
	bool "Enable JTAG"
	depends on !F1C100S_SDIO
	---help---
		Enable JTAG on PF (suniv function 3, not 4):
		PF0=TMS, PF1=TDI, PF3=TDO, PF5=TCK.
		WARNING: JTAG and SD Card share PF pins, cannot be used together.

endchoice

config F1C100S_SPI_INTERRUPTS
	bool "SPI Interrupt Mode"
	default n
	depends on F1C100S_SPI0 || F1C100S_SPI1
	---help---
		Enable interrupt-driven SPI transfers.
		Currently not fully implemented, use DMA mode instead.

config F1C100S_ST7789
	bool "ST7789 240x240 SPI status panel"
	default n
	depends on F1C100S_SPI1
	select DEV_GPIO
	select LCD
	select LCD_ST7789
	select LCD_FRAMEBUFFER
	select DRIVERS_VIDEO
	select VIDEO_FB
	select SPI_CMDDATA
	---help---
		ST7789 driver for BL status text (spec §2), on top of NuttX's
		standard drivers/lcd/st7789.c + LCD_FRAMEBUFFER front end (so
		it also shows up as /dev/fb0 for apps/examples/fb). SPI1 is
		PE7=CS PE8=MOSI PE9=CLK (Function 4) -- confirmed against this
		board's schematic and the F1C100S datasheet pin table; PA0-3
		Function 6 is a different, electrically valid SPI1 mux option
		on this silicon but on this board those 4 pins are wired to
		the RGB panel's touchscreen instead. DC and RST are GPIOs
		(defaults PE5/PE10), registered as named /dev/gpio devices
		(open+ioctl, not raw pokes); DC is also what f1c100s_spi.c's
		SPI_CMDDATA() toggles for the generic driver's command/data
		framing.

if F1C100S_ST7789

config F1C100S_ST7789_DC_PORT
	int "DC GPIO port (0=PA .. 4=PE 5=PF)"
	default 4

config F1C100S_ST7789_DC_PIN
	int "DC GPIO pin"
	default 5
	range 0 31

config F1C100S_ST7789_RST_PORT
	int "Reset GPIO port (0=PA .. 4=PE 5=PF)"
	default 4

config F1C100S_ST7789_RST_PIN
	int "Reset GPIO pin"
	default 10
	range 0 31

config F1C100S_ST7789_FREQUENCY
	int "ST7789 SPI frequency (unused; LCD_ST7789_FREQUENCY is the real one)"
	default 8000000

config F1C100S_ST7789_AP
	bool "This build is the AP (not BL)"
	default n
	---help---
		ST7789 always registers as /dev/fb0 (BL and AP never run at
		the same time, so there is no minor-number conflict there).
		The RGB LCD, which only exists in AP builds, always takes
		/dev/fb1 -- its mere presence already tells BL and AP apart.
		This flag only selects the status-screen title text
		("F1C100s BL" vs "F1C100s AP"); set it in AP-role defconfigs.

endif # F1C100S_ST7789

config F1C100S_BOOTKV
	bool "Boot KV state library (BL+AP spec §4)"
	default n
	depends on MTD
	---help---
		Dual-slot KV record in the 4 KiB SPI-NOR sector at
		F1C100S_PART_KV_OFFSET. Shared by NuttX-BL and NuttX-AP
		(fail_count, AP size/crc, active_flag). See f1c100s_bootkv.h
		for the power-fail atomicity protocol.

if F1C100S_BOOTKV

config F1C100S_BOOT_FAIL_LIMIT
	int "AP boot fail_count limit"
	default 3
	range 1 32
	---help---
		BL jumps to AP only while KV fail_count is below this
		limit (spec §2). Reaching the limit stays in BL for
		fastboot recovery instead of retrying a crashing AP.

endif # F1C100S_BOOTKV

endmenu

endif # ARCH_CHIP_CUSTOM
