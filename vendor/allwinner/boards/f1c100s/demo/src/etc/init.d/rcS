#include <nuttx/config.h>

#ifdef CONFIG_NET
ifconfig eth0 10.0.0.2 netmask 255.255.255.0
#endif

#ifdef CONFIG_EXAMPLES_DHCPD
dhcpd_start eth0
#endif

#ifdef CONFIG_FS_LITTLEFS
mkdir -p /data
#endif

#ifdef CONFIG_F1C100S_SDIO
mkdir -p /mnt
mount -t vfat /dev/mmcsd0 /mnt
#endif

#if defined(CONFIG_EXAMPLES_HTTPSD) || defined(CONFIG_LVX_USE_DEMO_CONTEST2026_000_HELLO_APP)
httpsd &
#endif

#ifdef CONFIG_EXAMPLES_WEBSERVER
webserver &
#endif

#ifdef CONFIG_SYSTEM_ADBD
adbd &
#endif

cat /etc/banner.txt
echo -n "  * 当前生效模式 : "
cat /data/net_mode
cat /etc/switch_guide.txt

