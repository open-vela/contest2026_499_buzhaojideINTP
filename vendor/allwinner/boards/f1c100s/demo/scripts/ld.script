MEMORY
{
    /* F1C100s has 32KB SRAM-A (0x00000000-0x00008000) */
    /* F1C100s has 32MB DRAM (0x80000000-0x82000000) */

    sram (rwx) : ORIGIN = 0x00000000, LENGTH = 32K
    dram (rwx) : ORIGIN = 0x80000000, LENGTH = 32M
}

OUTPUT_ARCH(arm)
ENTRY(_egon_header)
SECTIONS
{
    /* eGON Header - must be at the very beginning */
    .egon_header : {
        KEEP(*(.egon_header))
    } > dram

    .text : {
        _stext = ABSOLUTE(.);
        *(.vectors)
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.got)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)
        _etext = ABSOLUTE(.);
    } > dram

    .init_section : {
        _sinit = ABSOLUTE(.);
        KEEP(*(.init_array .init_array.*))
        _einit = ABSOLUTE(.);
    } > dram

    .ARM.extab : {
        *(.ARM.extab*)
    } > dram

    __exidx_start = ABSOLUTE(.);
    .ARM.exidx : {
        *(.ARM.exidx*)
    } > dram
    __exidx_end = ABSOLUTE(.);

    _eronly = ABSOLUTE(.);

    .data : {
        _sdata = ABSOLUTE(.);
        *(.data .data.*)
        *(.gnu.linkonce.d.*)
        CONSTRUCTORS
        . = ALIGN(4);
        _edata = ABSOLUTE(.);
    } > dram

    .bss : {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        _ebss = ABSOLUTE(.);
    } > dram

    /* Spec §6: leftover DRAM, not BSS-cleared, lost on power-off. */

    .crashlog (NOLOAD) : {
        . = ALIGN(8);
        _scrashlog = ABSOLUTE(.);
        KEEP(*(.crashlog))
        . = ALIGN(8);
        _ecrashlog = ABSOLUTE(.);
    } > dram

    /* Stabs debugging sections. */
    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
